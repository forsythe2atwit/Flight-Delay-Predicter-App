#!/usr/bin/env python3
"""
Compute Weather Delay Index (WDI) from a flight's weather points CSV.

Inputs:
  - CSV with columns: time, lat, lon, visibility, precipitation_probability,
    rain, showers, snowfall, snow_depth, windspeed_10m, windgusts_10m,
    apparent_temperature, dew_point_2m

Outputs:
  - <out_prefix>_per_point.csv  (risk components & severity per point)
  - <out_prefix>_summary.csv    (WDI and window stats)

Usage examples:
  python flight_weather_risk.py --in flight_weather.csv --out flight1
  python flight_weather_risk.py --in flight_weather.csv --out flight1 \
      --std 2025-09-27T18:55:00Z --atd 2025-09-27T23:01:00Z --sta 2025-09-28T00:50:00Z
  python flight_weather_risk.py --in flight_weather.csv --out flight1 \
      --weights 0.35 0.25 0.20 0.15 0.05
"""

import argparse
import numpy as np
import pandas as pd

# --------- Defaults (you can tune these) ---------
# Component weights: precip, visibility, wind, fog, snow (must sum ~1)
DEFAULT_WEIGHTS = (0.35, 0.25, 0.20, 0.15, 0.05)

# Heuristic mapping from WDI → expected delay minutes
WDI_X = np.array([0, 25, 50, 75, 100], dtype=float)
WDI_Y = np.array([0,  5, 15, 30,  60], dtype=float)  # calibrate later with real labels

# ------------------------------------------------

def parse_args():
    p = argparse.ArgumentParser(description="Compute Weather Delay Index from weather CSV.")
    p.add_argument("--in", dest="in_csv", required=True, help="Input CSV with weather points")
    p.add_argument("--out", dest="out_prefix", required=True, help="Output file prefix (no extension)")
    p.add_argument("--std", dest="std_iso", default=None, help="Scheduled Time of Departure (UTC ISO)")
    p.add_argument("--atd", dest="atd_iso", default=None, help="Actual Time of Departure (UTC ISO)")
    p.add_argument("--sta", dest="sta_iso", default=None, help="Scheduled Time of Arrival (UTC ISO)")
    p.add_argument("--weights", nargs=5, type=float, default=list(DEFAULT_WEIGHTS),
                   metavar=("W_PRECIP","W_VIS","W_WIND","W_FOG","W_SNOW"),
                   help="Component weights (sum ≈ 1)")
    p.add_argument("--dep_window_min", type=int, default=60, help="Minutes before STD for departure window")
    p.add_argument("--arr_window_min", type=int, default=60, help="Minutes around STA for arrival window (before/after)")
    p.add_argument("--phase_pct", type=float, default=0.20,
                   help="If no STD/STA, pct of points for dep/arr windows (default 0.20)")
    return p.parse_args()

def ensure_cols(df, cols):
    for c in cols:
        if c not in df.columns:
            df[c] = np.nan

def compute_risks(df, weights):
    """Compute per-point risk components and severity (0..100)."""
    # Visibility risk (0..100), linear from 10 km good → lower vis worse
    vis = pd.to_numeric(df["visibility"], errors="coerce")
    vis_risk = (1 - (vis / 10000.0)).clip(lower=0, upper=1) * 100

    # Precip risk: prob (0..1) & intensity_norm (mm/h capped 8 → 0..1)
    prob = pd.to_numeric(df["precipitation_probability"], errors="coerce").fillna(0) / 100.0
    rain = pd.to_numeric(df.get("rain", 0), errors="coerce").fillna(0)
    showers = pd.to_numeric(df.get("showers", 0), errors="coerce").fillna(0)
    snowfall = pd.to_numeric(df.get("snowfall", 0), errors="coerce").fillna(0)
    intensity_norm = (rain + showers + snowfall).clip(0, 8) / 8.0
    precip_risk = (0.7 * prob + 0.3 * intensity_norm) * 100  # heuristic split

    # Wind risk: primarily gusts; 100 km/h ~ 100 risk
    gusts = pd.to_numeric(df.get("windgusts_10m", np.nan), errors="coerce")
    windspeed = pd.to_numeric(df.get("windspeed_10m", 0), errors="coerce")
    gusts = gusts.fillna(windspeed)
    wind_risk = (gusts / 100.0).clip(0, 1) * 100

    # Fog proxy: small T−Td spread -> high risk; map 2°C->100, 6°C->0 (linear)
    T = pd.to_numeric(df.get("apparent_temperature", np.nan), errors="coerce")
    Td = pd.to_numeric(df.get("dew_point_2m", np.nan), errors="coerce")
    spread = T - Td
    fog_risk = (1 - ((spread - 2) / 4)).clip(0, 1) * 100  # clamp

    # Snow/ice risk: on if snowfall>0 or snow_depth>0
    snow_depth = pd.to_numeric(df.get("snow_depth", 0), errors="coerce").fillna(0)
    snow_flag = ((snowfall > 0) | (snow_depth > 0)).astype(int)
    snow_risk = snow_flag * 60 + (snowfall.clip(0, 5) / 5.0) * 40  # 0..100

    w_precip, w_vis, w_wind, w_fog, w_snow = weights
    severity = (
        w_precip * precip_risk +
        w_vis    * vis_risk +
        w_wind   * wind_risk +
        w_fog    * fog_risk +
        w_snow   * snow_risk
    )

    out = pd.DataFrame({
        "precip_risk": precip_risk.round(2),
        "vis_risk": vis_risk.round(2),
        "wind_risk": wind_risk.round(2),
        "fog_risk": fog_risk.round(2),
        "snow_risk": snow_risk.round(2),
        "severity_0_100": severity.round(2),
    })
    return out

def choose_windows(df, std_iso, atd_iso, sta_iso, dep_window_min=60, arr_window_min=60, phase_pct=0.20):
    """Return boolean masks for departure / en-route / arrival windows."""
    n = len(df)
    t = pd.to_datetime(df["time"], utc=True, errors="coerce")
    has_sched = bool(std_iso) and bool(sta_iso)
    if has_sched:
        STD = pd.to_datetime(std_iso, utc=True, errors="coerce")
        ATD = pd.to_datetime(atd_iso, utc=True, errors="coerce") if atd_iso else None
        STA = pd.to_datetime(sta_iso, utc=True, errors="coerce")

        dep_start = STD - pd.Timedelta(minutes=dep_window_min)
        dep_end   = ATD if ATD is not None else (STD + pd.Timedelta(minutes=dep_window_min))
        arr_start = STA - pd.Timedelta(minutes=arr_window_min)
        arr_end   = STA + pd.Timedelta(minutes=arr_window_min)

        dep_mask = (t >= dep_start) & (t <= dep_end)
        arr_mask = (t >= arr_start) & (t <= arr_end)
    else:
        # by position: first/last phase_pct of points
        k = max(1, int(phase_pct * n))
        dep_mask = pd.Series(False, index=df.index)
        dep_mask.iloc[:k] = True
        arr_mask = pd.Series(False, index=df.index)
        arr_mask.iloc[-k:] = True

    enroute_mask = ~(dep_mask | arr_mask)
    return dep_mask, enroute_mask, arr_mask, has_sched

def wdi_to_delay_minutes(wdi):
    if np.isnan(wdi):
        return np.nan
    return float(np.interp(wdi, WDI_X, WDI_Y))

def main():
    args = parse_args()
    in_csv = args.in_csv
    out_prefix = args.out_prefix
    weights = tuple(args.weights)

    # Load CSV
    df = pd.read_csv(in_csv)
    # required columns
    base_cols = ["time", "lat", "lon"]
    ensure_cols(df, base_cols)

    # normalize time
    df["time"] = pd.to_datetime(df["time"], utc=True, errors="coerce")
    df = df.sort_values("time").reset_index(drop=True)

    # ensure weather cols exist
    weather_cols = [
        "visibility", "precipitation_probability", "rain", "showers", "snowfall", "snow_depth",
        "windspeed_10m", "windgusts_10m", "apparent_temperature", "dew_point_2m"
    ]
    ensure_cols(df, weather_cols)

    # Compute per-point risks & severity
    risks = compute_risks(df, weights)
    df_out = pd.concat([df[["time","lat","lon"]].reset_index(drop=True), risks], axis=1)

    # Windows and segment scores
    dep_mask, enroute_mask, arr_mask, used_schedule = choose_windows(
        df, args.std_iso, args.atd_iso, args.sta_iso,
        dep_window_min=args.dep_window_min, arr_window_min=args.arr_window_min,
        phase_pct=args.phase_pct
    )

    dep_score = df_out.loc[dep_mask, "severity_0_100"].mean()
    enr_score = df_out.loc[enroute_mask, "severity_0_100"].mean()
    arr_score = df_out.loc[arr_mask, "severity_0_100"].mean()

    w_precip, w_vis, w_wind, w_fog, w_snow = weights  # only for record, not used here
    # Phase weights: 0.4 dep, 0.2 enroute, 0.4 arrival
    W_DEP, W_ENR, W_ARR = 0.4, 0.2, 0.4
    WDI = float(np.nansum([W_DEP*dep_score, W_ENR*enr_score, W_ARR*arr_score]))
    delay_min = wdi_to_delay_minutes(WDI)

    # Save outputs
    per_point_path = f"{out_prefix}_per_point.csv"
    summary_path   = f"{out_prefix}_summary.csv"
    df_out.to_csv(per_point_path, index=False)

    summary = pd.DataFrame([{
        "n_points": int(len(df_out)),
        "dep_points": int(dep_mask.sum()),
        "enroute_points": int(enroute_mask.sum()),
        "arr_points": int(arr_mask.sum()),
        "used_schedule_windows": used_schedule,
        "dep_score_mean": None if pd.isna(dep_score) else round(float(dep_score), 2),
        "enroute_score_mean": None if pd.isna(enr_score) else round(float(enr_score), 2),
        "arr_score_mean": None if pd.isna(arr_score) else round(float(arr_score), 2),
        "WDI_0_100": None if pd.isna(WDI) else round(float(WDI), 2),
        "heuristic_delay_min": None if pd.isna(delay_min) else round(float(delay_min), 1),
        "weights_precip_vis_wind_fog_snow": weights
    }])
    summary.to_csv(summary_path, index=False)

    print(f"✓ Saved per-point: {per_point_path}")
    print(f"✓ Saved summary:   {summary_path}")
    if not np.isnan(WDI):
        print(f"WDI = {WDI:.2f} (heuristic delay ≈ {delay_min:.1f} min)")
    else:
        print("WDI could not be computed (insufficient data).")

if __name__ == "__main__":
    main()
